# --- 시연(데모) 모드 ---
# 1: 로그인 없이 가상 계정으로 체험하고, 상단에서 직원·보호자를 전환하며, 데이터 초기화 버튼이 보입니다. (로컬 시연용)
# 비우거나 0: 실제 로그인이 필요합니다. 인터넷에 공개할 때는 반드시 비우세요.
DEMO_MODE=1

# --- AI 업무 제안(선택) ---
# 비워 두면 규칙 기반 '데모 분석'으로 동작합니다. 키는 서버에서만 쓰이며 프런트엔드에는 전달되지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- 기타(선택) ---
# SQLite 파일 경로(기본: ./pawcare.db)
PAWCARE_DB=
# 1로 두면 로그인 쿠키에 Secure 속성을 붙입니다(HTTPS로 서비스할 때)
COOKIE_SECURE=
